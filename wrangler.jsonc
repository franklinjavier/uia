// Cloudflare Workers, static assets only: the playground (Vite build) plus
// the registry JSON under /r/ (public/r is copied into dist).
//
//   bun run deploy           # build + publish
//   bun run cf:preview       # build + serve locally like production
//
// Served at uia.imfrank.dev (custom domain: Cloudflare creates the DNS
// record and certificate) and at uia.<account>.workers.dev.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uia",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "uia.imfrank.dev", "custom_domain": true }],
  // Declaring routes turns workers.dev off unless it's explicit.
  "workers_dev": true
}
