{
  "name": "uia-app",
  "private": true,
  "license": "MIT",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "registry": "bun scripts/registry.ts",
    "eval:surfaces": "bun scripts/eval-surfaces.ts",
    "registry:build": "bun scripts/registry.ts && bun scripts/catalog.ts && shadcn build --output public/r",
    "deploy": "bun run build && wrangler deploy",
    "cf:preview": "bun run build && wrangler dev"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.149",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/helpers": "^0.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "ai": "^7.0.145",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4",
    "thinking-orbs": "0.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "wrangler": "^4.151.2"
  }
}
