      "sidebar-foreground": "oklch(0.97 0 0)",
      "sidebar-primary": "oklch(0.97 0 0)",
      "sidebar-primary-foreground": "oklch(0.18 0 0)",
      "sidebar-accent": "oklch(0.25 0 0)",
      "sidebar-accent-foreground": "oklch(0.97 0 0)",
      "sidebar-border": "oklch(1 0 0 / 8%)",
      "sidebar-ring": "oklch(0.55 0 0)"
    }
  },
  "css": {
    "@utility eyebrow": {
      "font-family": "var(--font-mono)",
      "font-size": "11px",
      "line-height": "16px",
      "letter-spacing": "0.08em",
      "text-transform": "uppercase",
      "font-variant-numeric": "tabular-nums"
    },
    "@layer base": {
      "body": {
        "background-color": "var(--background)",
        "-webkit-font-smoothing": "antialiased"
      },
      "html": {
        "font-feature-settings": "\"cv11\", \"ss03\""
      }
    },
    ".typeset-chat": {
      "--typeset-font-body": "var(--font-sans)",
      "--typeset-font-heading": "var(--font-sans)",
      "--typeset-font-mono": "var(--font-mono)",
      "--typeset-size": "14px",
      "--typeset-leading": "1.65",
      "--typeset-flow": "0.85em"
    },
    ".typeset.typeset-chat": {
      "font-size": "var(--typeset-size)"
    }
  },
  "type": "registry:theme"
}