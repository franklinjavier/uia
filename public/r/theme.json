      "ring": "oklch(0.55 0 0)",
      "brand": "oklch(0.97 0 0)",
      "brand-foreground": "oklch(0.16 0 0)",
      "attention": "oklch(0.68 0.19 37)",
      "attention-foreground": "oklch(0.15 0 0)",
      "success": "oklch(0.8 0.22 145)",
      "warning": "oklch(0.78 0.15 65)",
      "info": "oklch(0.7 0.14 275)",
