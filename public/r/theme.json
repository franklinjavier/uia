      "muted": "oklch(0.955 0.004 286)",
      "muted-foreground": "oklch(0.55 0.012 286)",
      "faint-foreground": "oklch(0.7 0.01 286)",
      "accent": "oklch(0.955 0.004 286)",
      "accent-foreground": "oklch(0.18 0.005 286)",
      "destructive": "oklch(0.577 0.215 22)",
      "border": "oklch(0.915 0.005 286)",
      "input": "oklch(0.9 0.005 286)",
      "ring": "oklch(0.705 0.015 286)",
      "brand": "oklch(0.18 0.005 286)",
      "brand-foreground": "oklch(0.99 0 0)",
      "attention": "oklch(0.65 0.19 37)",
      "attention-foreground": "oklch(0.99 0 0)",
      "success": "oklch(0.64 0.16 152)",
      "warning": "oklch(0.7 0.16 60)",
      "info": "oklch(0.55 0.2 270)",
      "chart-1": "oklch(0.53 0.2 266)",
      "chart-2": "oklch(0.63 0.13 168)",
      "chart-3": "oklch(0.55 0.21 300)",
      "chart-4": "oklch(0.56 0.19 355)",
      "chart-5": "oklch(0.65 0.19 37)",
      "radius": "0.625rem",
      "widget-shadow": "0 0 0 1px oklch(0.18 0.01 286 / 0.06), 0 1px 2px oklch(0.18 0.01 286 / 0.04), 0 24px 48px -16px oklch(0.25 0.02 286 / 0.18)",
