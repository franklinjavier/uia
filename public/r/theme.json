{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "Theme",
  "description": "uia tokens: cool zinc light, neutral dark, ink brand, attention, semantic tones.",
  "cssVars": {
    "theme": {
      "color-surface": "var(--surface)",
      "color-faint-foreground": "var(--faint-foreground)",
      "color-brand": "var(--brand)",
      "color-brand-foreground": "var(--brand-foreground)",
      "color-attention": "var(--attention)",
      "color-attention-foreground": "var(--attention-foreground)",
      "color-success": "var(--success)",
      "color-warning": "var(--warning)",
      "color-info": "var(--info)",
      "shadow-widget": "var(--widget-shadow)",
      "ease-out-quint": "cubic-bezier(0.22, 1, 0.36, 1)",
      "animate-spin-slow": "spin 2.4s linear infinite"
    },
    "light": {
      "background": "oklch(0.995 0 0)",
