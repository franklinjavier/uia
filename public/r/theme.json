      "sidebar-border": "oklch(0.915 0.005 286)",
      "sidebar-ring": "oklch(0.705 0.015 286)"
    },
    "dark": {
      "background": "oklch(0.183 0 0)",
      "foreground": "oklch(0.97 0 0)",
      "surface": "oklch(0.2 0 0)",
      "card": "oklch(0.183 0 0)",
