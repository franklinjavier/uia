{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "uia",
  "homepage": "https://github.com/OWNER/uia",
  "items": [
    {
      "name": "font-inter",
      "type": "registry:font",
      "title": "Inter",
      "description": "Inter Variable as --font-sans.",
      "font": {
        "family": "'Inter Variable', sans-serif",
        "provider": "google",
        "import": "Inter",
        "variable": "--font-sans",
        "subsets": [
          "latin"
        ],
        "dependency": "@fontsource-variable/inter"
      }
    },
    {
      "name": "font-geist-mono",
      "type": "registry:font",
      "title": "Geist Mono",
      "description": "Geist Mono Variable as --font-mono (eyebrows, numbers, code).",
      "font": {
        "family": "'Geist Mono Variable', ui-monospace, monospace",
        "provider": "google",
        "import": "Geist_Mono",
        "variable": "--font-mono",
        "subsets": [
          "latin"
        ],
        "selector": "code, kbd, pre, samp",
        "dependency": "@fontsource-variable/geist-mono"
      }
    },
    {
